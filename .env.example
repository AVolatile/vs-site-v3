# Public analytics identifiers, optional. They are injected at build time and are not secrets.
PUBLIC_GA4_MEASUREMENT_ID=
PUBLIC_CLARITY_ID=

# Optional build-time public origin for canonical/social/schema URLs (Builds scope).
# Leave empty for the production origin in site.config.mjs; set deliberately for staging.
PUBLIC_SITE_URL=

# Server-only Neon connection string. Set a real value in an ignored local .env
# or Netlify's environment variables with Functions scope. Never prefix PUBLIC_.
DATABASE_URL=

# Server-only transactional email. Configure a verified sender and reply address
# in Netlify with Functions scope. Never prefix these variables PUBLIC_.
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=
# Optional HTTPS email asset origin override. Links use SITE_URL when configured.
# Transitional link fallback: EMAIL_PUBLIC_URL, then company.siteUrl.
EMAIL_PUBLIC_URL=

# Server-only trusted public origin for proposal/invoice/booking/email CTA links (Functions scope).
SITE_URL=
# Stable cryptographically random 32-byte key as 64 hex characters. Back it up securely.
BOOKING_TOKEN_SECRET=

# Phase 6B.1 server-only Outlook Calendar OAuth. Callback defaults to SITE_URL.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Optional: defaults to SITE_URL + /.netlify/functions/microsoft-calendar-oauth-callback
MICROSOFT_REDIRECT_URI=
# Optional: common supports personal and organizational accounts.
MICROSOFT_TENANT_ID=
INTEGRATION_ENCRYPTION_KEY=
# Zoom Server-to-Server OAuth; configured host email or user ID.
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_USER_ID=

# Stable server-only 32-byte hexadecimal key for hash-only invoice links. Back it up.
INVOICE_TOKEN_SECRET=
