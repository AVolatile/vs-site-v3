---
import '@styles/global.css';
import '@styles/booking.css';
import '@styles/admin.css';
import BookingActionDialog from '@components/booking/BookingActionDialog.astro';
import '@styles/.generated/phosphor.css';
import AdminNavigation from '@components/admin/AdminNavigation.astro';

interface Props {
  loginPresentation?: boolean;
  title?: string;
}

const { loginPresentation = false, title = "Inquiry Admin | Volatile Solutions" } = Astro.props;
---
<!doctype html>
<html lang="en" data-theme="nova">
  <head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" /><meta name="referrer" content="no-referrer" />
    <title>{title}</title>
    <link rel="icon" href="/vs-favicon.ico" />
    <link rel="apple-touch-icon" href="/vs-apple-touch-icon.png" />
  </head>
  <body class:list={['admin-ui', { 'admin-login-layout': loginPresentation }]}>
    {!loginPresentation && <AdminNavigation />}
    <main id="main-content" class:list={['admin-shell', { 'admin-login-shell': loginPresentation }]}>
      {loginPresentation ? (
        <>
          <div class="admin-login-content"><slot /></div>
          <aside class="admin-login-brand" aria-hidden="true">
            <img src="/assets/images/t001-nova/t001-nova-admin-mark.png" width="1122" height="1402" alt="" decoding="async" />
          </aside>
        </>
      ) : <slot />}
    </main>
    <BookingActionDialog />
    <script>
      import { setupAdminPresentation } from '@/lib/admin/presentation';
      setupAdminPresentation();
    </script>
  </body>
</html>
<style>
  .admin-login-brand { display: none; }

  :global(.admin-login-shell:has([data-admin-dashboard][hidden])) {
    display: grid;
    grid-template-areas: 'brand' 'form';
    grid-template-rows: auto 1fr;
    min-height: 100svh;
  }
  :global(.admin-login-shell:has([data-admin-dashboard][hidden])) .admin-login-content {
    grid-area: form;
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 0;
    padding: var(--spacing-lg) var(--spacing-container-px);
  }
  :global(.admin-login-shell:has([data-admin-dashboard][hidden])) .admin-login-brand {
    grid-area: brand;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--spacing-md);
    background: var(--color-brand-dark);
  }
  .admin-login-brand img { width: auto; height: 8rem; max-width: 100%; object-fit: contain; }
  :global(.admin-login-shell:has([data-admin-dashboard][hidden])) :global(.ui-section) {
    width: 100%;
    padding: 0;
    background: transparent;
  }
  :global(.admin-login-shell:has([data-admin-dashboard][hidden])) :global(.ui-container) {
    width: 100%;
    max-width: 30rem;
    margin: 0;
    padding: 0;
  }
  :global(.admin-login-shell:has([data-admin-dashboard][hidden])) :global(.admin-login-panel) {
    max-width: none;
    padding: 0;
    border: 0;
    background: transparent;
  }
  @media (min-width: 64rem) {
    :global(.admin-login-shell:has([data-admin-dashboard][hidden])) {
      grid-template-areas: 'form brand';
      grid-template-columns: minmax(0,48fr) minmax(0,52fr);
      grid-template-rows: 1fr;
    }
    :global(.admin-login-shell:has([data-admin-dashboard][hidden])) .admin-login-content {
      padding: var(--spacing-lg) clamp(2rem, 4vw, 4rem);
    }
    :global(.admin-login-shell:has([data-admin-dashboard][hidden])) .admin-login-brand {
      position: relative;
      overflow: hidden;
      padding: 0;
      min-width: 0;
    }
    .admin-login-brand img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center;
    }
    :global(.admin-login-shell:has([data-admin-dashboard][hidden]) .ui-container) {
      max-width: 26rem;
    }
    :global(.admin-login-shell:has([data-admin-dashboard][hidden]) .admin-area) {
      gap: 1.25rem;
    }
    :global(.admin-login-shell:has([data-admin-dashboard][hidden]) .admin-page-header) {
      display: block;
      padding-bottom: 0;
    }
    :global(.admin-login-shell:has([data-admin-dashboard][hidden]) .admin-page-intro) {
      gap: .75rem;
    }
    :global(.admin-login-shell:has([data-admin-dashboard][hidden]) .admin-page-header h1) {
      font-size: clamp(2.25rem, 3.5vw, 3.25rem);
      line-height: 1.05;
    }
    :global(.admin-login-shell:has([data-admin-dashboard][hidden]) .admin-login-panel) {
      gap: var(--spacing-md);
    }
    :global(.admin-login-shell:has([data-admin-dashboard][hidden]) .admin-login-panel > h2) {
      font-size: clamp(1.375rem, 1.7vw, 1.5rem);
      line-height: 1.25;
    }
    :global(.admin-login-shell:has([data-admin-dashboard][hidden]) .admin-login-panel > p) {
      font-size: .9375rem;
      line-height: 1.5;
    }
  }
  @media (max-width: 24rem) { .admin-header { flex-wrap: wrap; } }
</style>
