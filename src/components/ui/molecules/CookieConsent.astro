---
import cookieData from "@data/global/cookie-consent.json";
import Heading from "@components/ui/atoms/Heading.astro";
import Text from "@components/ui/atoms/Text.astro";
import Button from "@components/ui/atoms/Button.astro";

interface Props {
  title?: string;
  description?: string;
  acceptLabel?: string;
  essentialLabel?: string;
}

const {
  title = cookieData.title,
  description = cookieData.description,
  acceptLabel = cookieData.acceptLabel,
  essentialLabel = cookieData.essentialLabel,
} = Astro.props;
---

<section id="cookie-consent" class="cookie-consent" role="region" aria-labelledby="cookie-consent-title" aria-describedby="cookie-consent-description" hidden>
  <Heading id="cookie-consent-title" level={2} variant="feature-title">{title}</Heading>
  <Text id="cookie-consent-description" variant="feature-body-sm" class="cookie-consent-copy">{description}</Text>
  <Text variant="feature-body-sm" class="cookie-consent-policy">
    {cookieData.policyPrefix}{" "}<a href="/cookies/">{cookieData.policyLabel}</a>.
  </Text>
  <div class="cookie-consent-actions">
    <Button id="accept-cookies" type="button" size="sm" variant="primary">{acceptLabel}</Button>
    <Button id="decline-cookies" type="button" size="sm" variant="outline">{essentialLabel}</Button>
  </div>
</section>
<div id="cookie-consent-spacer" hidden aria-hidden="true"></div>
<Text id="cookie-consent-announcement" tag="span" class="sr-only" role="status" aria-live="polite" aria-atomic="true"></Text>

<script is:inline data-astro-rerun src="/js/cookie-consent.js" defer></script>

<style>
  .cookie-consent {
    position: fixed;
    z-index: 70;
    inset-inline-start: max(1rem, env(safe-area-inset-left));
    inset-inline-end: max(1rem, env(safe-area-inset-right));
    bottom: calc(8rem + env(safe-area-inset-bottom));
    max-height: calc(100dvh - 10rem - env(safe-area-inset-bottom) - env(safe-area-inset-top));
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 1.25rem;
    border: 1px solid var(--color-outline-variant);
    border-radius: var(--rounded-md);
    background: var(--color-brand-cream);
    color: var(--color-brand-dark);
    box-shadow: var(--ui-elevation-soft);
  }
  .cookie-consent[hidden] { display: none; }
  #cookie-consent-spacer[hidden] { display: none; }
  .cookie-consent :global(#cookie-consent-title) {
    margin: 0;
    font-size: 1.125rem;
    line-height: 1.3;
  }
  .cookie-consent :global(.cookie-consent-copy) {
    margin: .75rem 0 0;
    color: var(--color-on-surface-variant);
  }
  .cookie-consent :global(.cookie-consent-policy) { margin: .75rem 0 0; }
  .cookie-consent a {
    text-decoration: underline;
    text-decoration-color: var(--color-brand-accent);
    text-underline-offset: .2em;
  }
  .cookie-consent-actions { display: flex; gap: .75rem; margin-top: 1rem; }
  .cookie-consent-actions :global(.ui-button) {
    flex: 1;
    min-width: 0;
    min-height: 2.75rem;
    padding: .625rem 1rem;
    border-radius: var(--rounded-sm);
    box-shadow: none;
  }
  .cookie-consent a:focus-visible {
    outline: 2px solid var(--color-brand-dark);
    outline-offset: 4px;
  }
  .cookie-consent-actions :global(.ui-button:focus-visible) {
    outline: 2px solid var(--color-brand-dark);
    outline-offset: 3px;
  }
  @media (min-width: 768px) {
    .cookie-consent {
      inset-inline-start: max(1.5rem, env(safe-area-inset-left));
      inset-inline-end: auto;
      bottom: calc(1.5rem + env(safe-area-inset-bottom));
      width: 25rem;
      max-height: calc(100dvh - 3rem - env(safe-area-inset-bottom) - env(safe-area-inset-top));
      padding: 1.5rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .cookie-consent :global(.ui-button),
    .cookie-consent :global(.ui-button::after),
    .cookie-consent :global(.ui-button-text-default),
    .cookie-consent :global(.ui-button-text-hover) { transition: none; }
  }
  @media print { .cookie-consent { display: none; } }
</style>
