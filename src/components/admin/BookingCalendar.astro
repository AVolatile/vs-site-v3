---
import Section from '@components/ui/layout/Section.astro';
import BookingSummary from '@components/booking/BookingSummary.astro';
import Container from '@components/ui/layout/Container.astro';
import BookingSyncStatus from '@components/booking/BookingSyncStatus.astro';
import Heading from '@components/ui/atoms/Heading.astro';
import Text from '@components/ui/atoms/Text.astro';
import Button from '@components/ui/atoms/Button.astro';
import InquiryField from '@components/inquiry/InquiryField.astro';
---
<Section tone="page" class="py-10">
<Container class="max-w-7xl">
<div class="calendar-page booking-ui" data-booking-calendar>
 <div class="calendar-heading">
<div>
<Text variant="accent-label">Volatile Solutions / Admin</Text>
<Heading tag="h1" variant="section-title">Calendar</Heading>
</div>
<div class="calendar-actions">
<Button href="/admin/" variant="outline" size="sm">Inquiries</Button>
<Button href="/admin/settings/integrations/" variant="outline" size="sm">Integrations</Button>
<Button href="/admin/calendar/settings/" variant="outline" size="sm">Availability</Button>
<Button type="button" variant="ghost" class="booking-tertiary" size="sm" data-calendar-logout>Sign out</Button>
</div>
</div>
 <Text variant="body" role="status" aria-live="polite" data-calendar-feedback>Checking access…</Text>
 <div data-calendar-private hidden class="calendar-private">
  <div class="calendar-toolbar">
<div class="calendar-actions">
<Button type="button" variant="outline" size="sm" data-calendar-previous>Previous</Button>
<Button type="button" variant="outline" size="sm" data-calendar-today>Today</Button>
<Button type="button" variant="outline" size="sm" data-calendar-next>Next</Button>
</div>
<Heading tag="h2" variant="feature-title" data-calendar-month>
</Heading>
<div class="calendar-actions" role="group" aria-label="Calendar view">
<Button type="button" variant="outline" size="sm" data-calendar-view="month" aria-pressed="true">Month</Button>
<Button type="button" variant="outline" size="sm" data-calendar-view="agenda" aria-pressed="false">Agenda</Button>
</div>
</div>
  <Text variant="feature-body-sm" class="text-on-surface-variant" data-calendar-timezone>
</Text>
  <Text variant="feature-body-sm" class="calendar-mobile-note">Appointments by date</Text>
  <div data-calendar-grid class="calendar-grid" role="group" aria-label="Monthly bookings">
</div>
  <div data-calendar-agenda class="calendar-agenda">
</div>
  <Text variant="body" data-calendar-empty hidden>No bookings scheduled in this month.</Text>
  <section data-calendar-detail hidden class="calendar-detail" aria-labelledby="calendar-detail-heading">
<Heading id="calendar-detail-heading" tag="h2" variant="feature-title" tabindex="-1">Booking details</Heading>
<BookingSummary data-calendar-detail-copy/>
<BookingSyncStatus />
<Text variant="body" data-calendar-detail-contact></Text>
<Text variant="body" data-calendar-detail-notes>
</Text>
<div class="calendar-actions">
<Button href="/admin/" variant="outline" size="sm" data-calendar-inquiry>Open inquiry</Button>
<Button href="mailto:" variant="outline" size="sm" data-calendar-email>Email client</Button>
<Button type="button" variant="ghost" class="booking-tertiary booking-destructive" size="sm" data-calendar-cancel>Cancel booking</Button>
<Button type="button" variant="primary" size="sm" data-calendar-complete>Mark completed</Button>
<Button type="button" variant="ghost" class="booking-tertiary" size="sm" data-calendar-close>Close details</Button>
</div>
<Text variant="feature-body-sm" data-calendar-complete-hint>Completion is available after the call ends.</Text>
<form data-calendar-reschedule-form novalidate class="calendar-reschedule">
<Heading tag="h3" variant="feature-title">Reschedule</Heading>
<InquiryField compact name="rescheduleDate" label="New date" type="date" required/>
<InquiryField compact name="rescheduleStart" label="Available time" type="select" required options={[]}/>
<Button type="submit" variant="outline">Confirm new time</Button>
</form>
</section>
 </div>
 <template data-calendar-day-template>
<div class="calendar-day">
<Text tag="span" variant="feature-body-sm" data-calendar-day-label>
</Text>
<div data-calendar-day-bookings>
</div>
</div>
</template>
 <template data-calendar-event-template>
   <Button type="button" variant="outline" size="sm" class="booking-event" data-calendar-event>
     <span class="booking-event-content">
       <Text tag="span" variant="feature-body-sm" data-calendar-event-time></Text>
       <Text tag="span" variant="body" data-calendar-event-client></Text>
       <Text tag="span" variant="feature-body-sm" data-calendar-event-company></Text>
       <span class="booking-event-meta">
         <Text tag="span" variant="feature-body-sm" data-calendar-event-meeting></Text>
         <Text tag="span" variant="feature-body-sm" data-calendar-event-status></Text>
       </span>
     </span>
   </Button>
 </template>
 <template data-calendar-agenda-template>
   <section class="booking-agenda-section">
     <Heading tag="h3" variant="feature-title" data-calendar-agenda-date></Heading>
     <div class="booking-agenda-events" data-calendar-agenda-events></div>
   </section>
 </template>
</div>
</Container>
</Section>
<script>
import { setupCalendar } from '@/lib/bookings/calendar';
void setupCalendar();
</script>
<style>
[hidden] {
  display: none !important;
}
.calendar-page,
.calendar-private,
.calendar-agenda,
.calendar-detail,
.calendar-reschedule {
  display: grid;
  gap: var(--spacing-lg);
  min-width: 0;
}
.calendar-heading,
.calendar-toolbar,
.calendar-actions {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: var(--spacing-sm);
}
.calendar-heading {
  justify-content: space-between;
}
.calendar-heading > div:first-child {
  display: grid;
  gap: var(--spacing-sm);
}
.calendar-toolbar {
  justify-content: space-between;
  padding-bottom: var(--spacing-md);
  border-bottom: 1px solid var(--color-outline-variant);
}
.calendar-private {
  padding: clamp(1rem, 2.5vw, 2rem);
  border: 1px solid var(--color-outline-variant);
  border-radius: var(--ui-radius-md);
  background: var(--color-brand-cream);
  gap: var(--spacing-md);
}
.calendar-grid {
  display: grid;
  grid-template-columns: repeat(7, minmax(0, 1fr));
  gap: var(--spacing-sm);
  min-width: 0;
}
.calendar-grid :global(.calendar-day) {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-sm);
  padding: var(--spacing-sm);
  border: 1px solid var(--color-outline-variant);
  border-radius: var(--ui-radius-sm);
  background: var(--color-brand-light);
  min-height: 8.5rem;
  min-width: 0;
}
.calendar-grid :global([data-calendar-day-label]) {
  color: var(--color-on-surface-variant);
  font-size: 0.75rem;
  padding-bottom: var(--spacing-sm);
  border-bottom: 1px solid var(--color-outline-variant);
}
.calendar-grid :global(.calendar-day[data-today='true']) {
  border-color: var(--color-brand-accent);
}
.calendar-grid
  :global(.calendar-day[data-today='true'] [data-calendar-day-label]) {
  color: var(--color-on-surface);
  font-weight: 700;
}
.calendar-grid :global([data-calendar-day-bookings]) {
  display: grid;
  gap: var(--spacing-sm);
}
.calendar-page :global(.booking-event) {
  display: block;
  height: auto;
  width: 100%;
  min-height: 2.75rem;
  padding: var(--spacing-md);
  border: 1px solid var(--color-outline-variant);
  border-radius: var(--ui-radius-sm);
  white-space: normal;
  text-align: left;
  background: var(--color-brand-light);
}
.calendar-grid :global(.booking-event) {
  padding: var(--spacing-sm);
}
.calendar-page :global(.booking-event .ui-button-text-wrap) {
  display: grid;
  white-space: normal;
  justify-items: start;
  width: 100%;
}
.calendar-page :global(.booking-event-content) {
  display: grid;
  gap: 0.35rem;
  width: 100%;
  min-width: 0;
}
.calendar-page :global(.booking-event-content span) {
  white-space: normal;
  overflow-wrap: anywhere;
  letter-spacing: normal;
  text-transform: none;
}
.calendar-page :global([data-calendar-event-time]),
.calendar-page :global([data-calendar-event-client]) {
  font-size: 0.875rem;
  line-height: 1.4;
  font-weight: 600;
}
.calendar-page :global([data-calendar-event-company]) {
  color: var(--color-on-surface-variant);
  font-size: 0.75rem;
  font-weight: 400;
}
.calendar-page :global(.booking-event-meta) {
  display: flex;
  flex-wrap: wrap;
  gap: var(--spacing-sm);
  color: var(--color-on-surface-variant);
  padding-top: 0.25rem;
}
.calendar-page :global(.booking-event-meta span) {
  font-size: 0.75rem;
  font-weight: 400;
}
.calendar-grid :global([data-calendar-event-company]) {
  display: none;
}
.calendar-page :global(.booking-event .ui-button-text-hover) {
  display: none;
}
.calendar-page :global(.booking-event:hover .ui-button-text-default) {
  transform: none;
  opacity: 1;
}
.calendar-page :global(.booking-event:focus-visible) {
  outline: 2px solid var(--color-primary);
  outline-offset: 3px;
}
.calendar-agenda :global(.booking-agenda-section) {
  display: grid;
  gap: var(--spacing-md);
  min-width: 0;
  padding-block: var(--spacing-md);
  border-bottom: 1px solid var(--color-outline-variant);
}
.calendar-agenda :global(.booking-agenda-events) {
  display: grid;
  gap: var(--spacing-sm);
}
.calendar-detail {
  padding-top: var(--spacing-lg);
  border-top: 1px solid var(--color-outline-variant);
}
.calendar-page :global([data-calendar-detail-contact]),
.calendar-page :global([data-calendar-detail-notes]) {
  white-space: pre-line;
  overflow-wrap: anywhere;
}
.calendar-page :global([data-calendar-feedback]) {
  font-size: 1rem;
  color: var(--color-on-surface-variant);
}
.calendar-page :global([data-calendar-feedback][role='alert']) {
  color: var(--color-error);
}
.calendar-page :global([data-calendar-view][aria-pressed='true']) {
  background: var(--color-brand-dark);
  color: var(--color-on-primary);
  border-color: var(--color-brand-dark);
}
.calendar-page :global([data-calendar-empty]) {
  padding-block: var(--spacing-lg);
  color: var(--color-on-surface-variant);
}
.calendar-reschedule {
  max-width: 40rem;
  gap: var(--spacing-md);
}
.calendar-mobile-note {
  display: none;
}
@media (min-width: 48rem) {
  .calendar-reschedule {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .calendar-reschedule > :global(h3) {
    grid-column: 1/-1;
  }
  .calendar-reschedule > :global(button) {
    justify-self: start;
  }
  .calendar-agenda :global(.booking-agenda-section) {
    grid-template-columns: 12rem minmax(0, 1fr);
    align-items: start;
  }
}
@media (max-width: 63.999rem) {
  .calendar-grid {
    display: none;
  }
  .calendar-mobile-note {
    display: block;
    color: var(--color-on-surface-variant);
  }
  .calendar-toolbar {
    align-items: start;
  }
  .calendar-toolbar > :global(h2) {
    order: -1;
    flex-basis: 100%;
  }
  .calendar-actions {
    justify-content: flex-start;
  }
}
@media (max-width: 23rem) {
  .calendar-toolbar .calendar-actions {
    gap: var(--spacing-xs);
  }
  .calendar-toolbar :global(.ui-button) {
    padding-inline: 0.6rem;
  }
}
</style>
