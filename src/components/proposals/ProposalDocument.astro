---
import Heading from '@components/ui/atoms/Heading.astro';
import Text from '@components/ui/atoms/Text.astro';
interface Props { adminPreview?: boolean; }
const {adminPreview=false}=Astro.props;
const titleTag=adminPreview?'h3':'h1';
const sectionTag=adminPreview?'h4':'h2';
---
<article class="proposal-document" data-proposal-document hidden aria-labelledby="proposal-title">
  <header class="document-heading">
    <div><Text variant="accent-label">Proposal / Estimate</Text><Heading id="proposal-title" tag={titleTag} variant="section-title" data-proposal-value="title"></Heading></div>
    <Text tag="span" variant="feature-body-sm" class="proposal-status" data-proposal-value="status"></Text>
  </header>
  <dl class="document-meta">
    <div><Text tag="dt" variant="feature-body-sm">Proposal number</Text><Text tag="dd" variant="body" data-proposal-value="number"></Text></div>
    <div><Text tag="dt" variant="feature-body-sm">Date</Text><Text tag="dd" variant="body" data-proposal-value="date"></Text></div>
    <div><Text tag="dt" variant="feature-body-sm">Valid through (UTC)</Text><Text tag="dd" variant="body" data-proposal-value="validUntil"></Text></div>
  </dl>
  <section class="prepared-for"><Heading tag={sectionTag} variant="feature-title">Prepared for</Heading><Text variant="body" data-proposal-client="name"></Text><Text variant="body" data-proposal-client="company"></Text><Text variant="body" data-proposal-client="email"></Text></section>
  <section class="document-summary"><Heading tag={sectionTag} variant="feature-title">Project overview</Heading><Text variant="body" data-proposal-value="summary"></Text></section>
  <div class="document-table-wrap"><table><caption class="sr-only">Proposal line items in USD</caption><thead><tr><th scope="col">Description</th><th scope="col">Quantity</th><th scope="col">Rate</th><th scope="col">Amount</th></tr></thead><tbody data-proposal-items></tbody></table></div>
  <dl class="document-totals">
    {[['subtotalCents','Subtotal'],['discountCents','Discount'],['taxCents','Tax'],['totalCents','Total (USD)']].map(([key,label]) => <div><Text tag="dt" variant="body">{label}<Text tag="span" variant="feature-body-sm" data-proposal-tax-rate hidden></Text></Text><Text tag="dd" variant="body" data-proposal-value={key}></Text></div>)}
  </dl>
  <section class="document-client-notes" data-proposal-notes hidden><Heading tag={sectionTag} variant="feature-title">Additional notes</Heading><Text variant="body" data-proposal-value="clientNotes"></Text></section>
</article>
<style>
  [hidden] { display: none !important; }
  .proposal-document { display: grid; gap: var(--spacing-lg); min-width: 0; }
  .document-heading { display: flex; justify-content: space-between; align-items: start; flex-wrap: wrap; gap: var(--spacing-md); }
  .document-heading > div { display: grid; gap: var(--spacing-sm); min-width: 0; }
  .document-heading :global(h1) { overflow-wrap: anywhere; }
  .proposal-status { padding: var(--spacing-xs) var(--spacing-sm); border-radius: var(--ui-radius-sm); background: var(--color-brand-cream); }
  .proposal-status[data-status="accepted"] { color: var(--color-on-success-container); background: var(--color-success-container); }
  .proposal-status[data-status="declined"],.proposal-status[data-status="expired"] { color: var(--color-on-error-container); background: var(--color-error-container); }
  .document-meta { display: grid; gap: var(--spacing-md); margin: 0; padding-block: var(--spacing-md); border-block: 1px solid var(--color-outline-variant); }
  .document-meta > div { min-width: 0; }
  .document-meta :global(dt) { color: var(--color-on-surface-variant); }
  .proposal-document :global(dd) { margin: 0; overflow-wrap: anywhere; }
  .prepared-for,.document-summary,.document-client-notes { display: grid; gap: var(--spacing-sm); }
  .document-summary :global(p),.document-client-notes :global(p) { white-space: pre-wrap; overflow-wrap: anywhere; }
  .document-table-wrap { min-width: 0; }
  table { width: 100%; border-collapse: collapse; table-layout: fixed; }
  th,:global([data-proposal-items] td) { text-align: right; padding: var(--spacing-sm); border-bottom: 1px solid var(--color-outline-variant); overflow-wrap: anywhere; font-size: .875rem; }
  th { color: var(--color-on-surface-variant); background: var(--color-brand-cream); }
  th:first-child,:global([data-proposal-items] td:first-child) { text-align: left; width: 48%; }
  .document-totals { display: grid; gap: var(--spacing-sm); margin: 0; width: min(100%,24rem); justify-self: end; }
  .document-totals > div { display: flex; justify-content: space-between; gap: var(--spacing-md); }
  .document-totals > div:last-child { padding-top: var(--spacing-md); border-top: 2px solid var(--color-on-surface); font-weight: 700; }
  .document-totals > div:last-child :global(dt),.document-totals > div:last-child :global(dd) { font-weight: 700; font-size: 1.375rem; }
  @media (min-width: 48rem) { .document-meta { grid-template-columns: repeat(3,minmax(0,1fr)); } }
  @media (max-width: 29.999rem) {
    thead { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
    table,:global([data-proposal-items]) { display: block; }
    :global([data-proposal-items] tr) { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: var(--spacing-sm); padding-block: var(--spacing-md); border-bottom: 1px solid var(--color-outline-variant); }
    :global([data-proposal-items] td) { border: 0; padding: 0; text-align: left; }
    :global([data-proposal-items] td:first-child) { grid-column: 1 / -1; width: auto; white-space: pre-wrap; }
    :global([data-proposal-items] td:not(:first-child)::before) { content: attr(data-label); display: block; color: var(--color-on-surface-variant); font-size: .75rem; }
  }
  @media print {
    .proposal-document { display: block; color: #000; }
    .proposal-document > * { margin-bottom: 5mm; }
    .document-summary,.document-client-notes { display: block; }
    .document-summary :global(h2),.document-client-notes :global(h2) { margin-bottom: 3mm; }
    .document-totals { margin-top: 6mm; margin-left: auto; }
    .document-heading,.document-meta,.prepared-for,.document-totals { break-inside: avoid; }
    .document-meta { grid-template-columns: repeat(3,minmax(0,1fr)); }
    table { display: table; table-layout: fixed; }
    thead { display: table-header-group; position: static; width: auto; height: auto; clip-path: none; }
    :global([data-proposal-items]) { display: table-row-group; }
    :global([data-proposal-items] tr) { display: table-row; break-inside: avoid; }
    :global([data-proposal-items] td) { display: table-cell; padding: 3mm; border-bottom: 1px solid #ccc; text-align: right; }
    :global([data-proposal-items] td:first-child) { width: 48%; text-align: left; }
    :global([data-proposal-items] td::before) { display: none; }
    .proposal-document :global(h1) { font-size: 24pt; }
    .proposal-status { background: transparent; border: 1px solid #ccc; }
  }
</style>
