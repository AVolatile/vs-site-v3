---
import Heading from '@components/ui/atoms/Heading.astro';
import Text from '@components/ui/atoms/Text.astro';
import Button from '@components/ui/atoms/Button.astro';
interface Props { headingTag?:'h2'|'h3'|'h4'; }
const {headingTag='h2'}=Astro.props;
---
<section data-invoice-context hidden class="invoice-context">
 <Heading tag={headingTag} variant="feature-title">Invoice</Heading>
 <Text variant="body" role="status" aria-live="polite" data-invoice-context-message></Text>
 <Button type="button" variant="outline" size="sm" data-invoice-create hidden>Create invoice</Button>
 <div data-invoice-context-summary hidden>
  <div class="invoice-facts"><Text tag="span" data-invoice-number></Text><Text tag="span" data-invoice-status></Text><Text tag="span" data-invoice-total></Text><Text tag="span" variant="feature-body-sm" data-invoice-dates></Text></div>
  <div class="invoice-actions"><Button href="/admin/" variant="outline" size="sm" data-invoice-open="view">View invoice</Button><Button href="/admin/" variant="outline" size="sm" data-invoice-open="edit">Edit invoice</Button></div>
 </div>
</section>
<style>
 [hidden]{display:none!important;}
 .invoice-context{display:grid;gap:var(--spacing-sm);grid-column:1/-1;min-width:0;padding-top:var(--spacing-md);border-top:1px solid var(--color-outline-variant);}
 .invoice-facts,.invoice-actions{display:flex;align-items:center;flex-wrap:wrap;gap:var(--spacing-sm);}
 .invoice-facts{margin-bottom:var(--spacing-sm);}
 .invoice-facts :global(span){overflow-wrap:anywhere;}
</style>
