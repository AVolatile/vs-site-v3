---
import Section from '@components/ui/layout/Section.astro';
import Container from '@components/ui/layout/Container.astro';
import Heading from '@components/ui/atoms/Heading.astro';
import Text from '@components/ui/atoms/Text.astro';
import Button from '@components/ui/atoms/Button.astro';
import Icon from '@components/ui/atoms/Icon.astro';
import SmartImage from '@components/ui/atoms/SmartImage.astro';
import SectionHeader from '@components/ui/molecules/SectionHeader.astro';
import { isExternal } from '@utils/url';
import type { PortfolioData } from '@/types/portfolio';

interface Props { data: PortfolioData }
const { data } = Astro.props as Props;
const categoryLabels = new Map(data.categories.map((category) => [category.id, category.cardLabel ?? category.label]));
---

<Section tone="page" class="pt-12 pb-8">
  <Container class="w-full max-w-none px-[clamp(1.5rem,5vw,5rem)]">
    <div data-motion-sequence="fade">
      <SectionHeader tagline={data.intro.eyebrow} title={data.intro.heading} description={data.intro.description} variant="hero" hasMargin={false} />
    </div>
  </Container>
</Section>

<Section id="portfolio-work" tone="page" class="pt-8 pb-16">
  <Container class="w-full max-w-none px-[clamp(1.5rem,5vw,5rem)]">
    <div data-portfolio-collection data-creative-categories={data.creativeCategoryIds.join(' ')} data-creative-label={data.labels.creative} data-singular={data.labels.projectSingular} data-plural={data.labels.projectPlural} data-initial-count={data.browsing.initialCount} data-increment={data.browsing.increment} data-show-more-label={data.labels.showMore} data-showing-label={data.labels.showing} data-of-label={data.labels.of}>
      <div class="portfolio-controls">
        <div class="portfolio-filters" role="group" aria-label={data.labels.filters} data-portfolio-filters hidden>
          {data.categories.map((category) => (
            <Button type="button" variant="outline" class="portfolio-filter min-h-11" aria-controls="portfolio-grid" aria-pressed={category.id === 'all' ? 'true' : 'false'} data-portfolio-filter={category.id}>
              <span slot="icon-left" class="portfolio-filter-check" aria-hidden="true"><Icon name="check" /></span>
              {category.label}
            </Button>
          ))}
        </div>
        <Text variant="body" class="text-sm text-on-surface-variant" role="status" aria-live="polite" aria-atomic="true" data-portfolio-count>
          {data.items.length} {data.labels.projectPlural}
        </Text>
      </div>

      <div id="portfolio-grid" class="portfolio-grid" role="list" aria-label={data.intro.heading}>
        {data.items.map((item) => {
          const href = item.detailHref ?? item.externalUrl ?? item.artworkHref;
          const actionLabel = item.actionLabel ?? (item.detailHref ? data.labels.viewDetail : item.externalUrl ? data.labels.viewLive : data.labels.viewArtwork);
          const external = href ? isExternal(href) : false;
          const imageFit = item.imageFit ?? 'cover';
          const isIdentityBoard = imageFit === 'contain' && item.categories.includes('branding') && item.tags?.includes('Brand Identity');
          const isThumbnail = item.mediaAspect === '16:9';
          return (
            <article id={item.id} class="portfolio-card" role="listitem" data-portfolio-item data-categories={item.categories.join(' ')} aria-labelledby={`${item.id}-title`}>
              <figure class="portfolio-card-image group" data-image-fit={imageFit} data-media-aspect={item.mediaAspect} data-identity-board={isIdentityBoard ? '' : undefined} style={item.imagePosition ? { '--portfolio-image-position': item.imagePosition } : undefined}>
                <SmartImage src={item.image} alt={item.alt} width={1280} height={isThumbnail ? 720 : 960} sizes="(min-width: 768px) 45vw, 90vw" loading="lazy" class={isIdentityBoard || isThumbnail ? undefined : 'transition-transform duration-[1200ms] ease-out group-hover:scale-[1.02] motion-reduce:transition-none'} />
              </figure>
              <div class="portfolio-card-content">
                <div class="flex min-w-0 flex-wrap items-center justify-between gap-2">
                  <Text tag="span" variant="accent-label">{categoryLabels.get(item.categories[0])}</Text>
                  <Text tag="span" variant="feature-body-sm" class="text-on-surface-variant">{item.classification}</Text>
                </div>
                <Heading tag="h2" variant="feature-title" id={`${item.id}-title`} tabindex="-1" class="focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brand-accent">{item.title}</Heading>
                <Text variant="body">{item.shortDescription}</Text>
                {item.imageNote && <Text variant="feature-body-sm" class="text-on-surface-variant">{item.imageNote}</Text>}
                {(item.tags?.length || item.technologies?.length) && (
                  <ul role="list" class="portfolio-tags" aria-label={data.labels.tags}>
                    {[...(item.tags ?? []), ...(item.technologies ?? [])].map((tag) => <li><Text tag="span" variant="feature-body-sm">{tag}</Text></li>)}
                  </ul>
                )}
                {href && (
                  <div class="portfolio-card-action">
                    <Button href={href} variant="outline" class="min-h-11" aria-label={`${actionLabel}: ${item.title}`} target={external || item.artworkHref === href ? '_blank' : undefined} rel={external || item.artworkHref === href ? 'noopener noreferrer' : undefined}>
                      {actionLabel}
                      <span slot="icon-right" aria-hidden="true"><Icon name={external ? 'arrow-up-right' : 'image'} /></span>
                    </Button>
                  </div>
                )}
              </div>
            </article>
          );
        })}
      </div>
      <Text variant="body" data-portfolio-empty hidden>{data.labels.empty}</Text>
      <div class="portfolio-more" data-portfolio-more hidden>
        <Button type="button" variant="outline" class="min-h-11" data-portfolio-show-more aria-controls="portfolio-grid">{data.labels.showMore}</Button>
      </div>
    </div>
  </Container>
</Section>

<Section tone="base" class="py-12 md:py-16">
  <Container class="w-full max-w-none px-[clamp(1.5rem,5vw,5rem)]">
    <div class="flex min-w-0 flex-col items-start justify-between gap-6 md:flex-row md:items-center" data-motion-sequence="viewport">
      <div class="grid min-w-0 gap-4">
        <Heading tag="h2" variant="section-title">{data.contact.heading}</Heading>
        <Text variant="lead">{data.contact.description}</Text>
      </div>
      <Button href={data.contact.href} variant="primary" class="min-h-11 shrink-0">{data.contact.label}</Button>
    </div>
  </Container>
</Section>

<script>
  let filterAbort: AbortController | null = null;

  function setupPortfolio() {
    filterAbort?.abort();
    const root = document.querySelector<HTMLElement>('[data-portfolio-collection]');
    if (!root) return;
    const grid = root.querySelector<HTMLElement>('#portfolio-grid');
    const controls = root.querySelector<HTMLElement>('[data-portfolio-filters]');
    const count = root.querySelector<HTMLElement>('[data-portfolio-count]');
    const empty = root.querySelector<HTMLElement>('[data-portfolio-empty]');
    const more = root.querySelector<HTMLElement>('[data-portfolio-more]');
    const moreButton = root.querySelector<HTMLButtonElement>('[data-portfolio-show-more]');
    const buttons = [...root.querySelectorAll<HTMLButtonElement>('[data-portfolio-filter]')];
    const cards = [...root.querySelectorAll<HTMLElement>('[data-portfolio-item]')];
    if (!grid || !controls || !count || !empty || !more || !moreButton) return;

    filterAbort = new AbortController();
    const { signal } = filterAbort;
    const creative = new Set(root.dataset.creativeCategories?.split(' ') ?? []);
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let filterAnimation: Animation | undefined;
    const known = new Set(buttons.map((button) => button.dataset.portfolioFilter));
    const initialCount = Math.max(1, Number(root.dataset.initialCount) || 12);
    const increment = Math.max(1, Number(root.dataset.increment) || initialCount);
    let visibleLimit = initialCount;
    let currentCategory = 'all';

    function rememberLimit() {
      history.replaceState({ ...history.state, portfolioVisibleLimit: visibleLimit }, '', window.location.href);
    }

    function selectionFromUrl() {
      const value = new URL(window.location.href).searchParams.get('category');
      return value === 'creative' || known.has(value ?? '') ? value ?? 'all' : 'all';
    }

    function matches(card: HTMLElement, category: string) {
      const categories = card.dataset.categories?.split(' ') ?? [];
      return category === 'all' || categories.some((id) => category === 'creative' ? creative.has(id) : id === category);
    }

    function apply(category: string, animate = false) {
      currentCategory = category;
      let visible = 0;
      let total = 0;
      for (const card of cards) {
        const matching = matches(card, category);
        if (matching) total++;
        card.hidden = !matching || (category === 'all' && visible >= visibleLimit);
        if (!card.hidden) visible++;
      }
      for (const button of buttons) {
        const id = button.dataset.portfolioFilter ?? 'all';
        button.setAttribute('aria-pressed', String(category === 'creative' ? creative.has(id) : id === category));
      }
      const label = category === 'creative' ? root!.dataset.creativeLabel : buttons.find((button) => button.dataset.portfolioFilter === category)?.querySelector('.ui-button-text-default')?.textContent?.trim();
      count!.textContent = category === 'all'
        ? `${root!.dataset.showingLabel} ${visible} ${root!.dataset.ofLabel} ${total} ${root!.dataset.plural}`
        : `${total} ${total === 1 ? root!.dataset.singular : root!.dataset.plural}${label ? ` / ${label}` : ''}`;
      empty!.hidden = total > 0;
      more!.hidden = category !== 'all' || visible >= total;
      const nextCount = Math.min(increment, total - visible);
      moreButton!.setAttribute('aria-label', `${root!.dataset.showMoreLabel}: ${nextCount} ${nextCount === 1 ? root!.dataset.singular : root!.dataset.plural}`);
      filterAnimation?.cancel();
      if (animate && !reducedMotion.matches) {
        filterAnimation = grid!.animate([{ opacity: 0.65 }, { opacity: 1 }], { duration: 180, easing: 'ease-out' });
      }
    }

    function restore() {
      let category = selectionFromUrl();
      const storedLimit = history.state?.portfolioVisibleLimit;
      visibleLimit = typeof storedLimit === 'number' && Number.isFinite(storedLimit)
        ? Math.min(cards.length, Math.max(initialCount, storedLimit))
        : initialCount;
      // A project deep link must stay visible even when an incompatible filter is in the URL.
      const anchor = cards.find((card) => `#${card.id}` === window.location.hash);
      if (anchor && !matches(anchor, category)) {
        category = 'all';
        const url = new URL(window.location.href);
        url.searchParams.delete('category');
        history.replaceState(history.state, '', url);
      }
      // Reveal the entire preceding batch so a direct project link cannot land on a hidden card.
      if (anchor && category === 'all') {
        visibleLimit = Math.min(cards.length, Math.max(visibleLimit, Math.ceil((cards.indexOf(anchor) + 1) / increment) * increment));
      }
      apply(category);
      rememberLimit();
    }

    for (const button of buttons) {
      button.addEventListener('click', () => {
        const category = button.dataset.portfolioFilter ?? 'all';
        const url = new URL(window.location.href);
        if (category === 'all') url.searchParams.delete('category');
        else url.searchParams.set('category', category);
        url.hash = '';
        if (url.href !== window.location.href) history.pushState({ ...history.state, portfolioVisibleLimit: visibleLimit }, '', url);
        apply(category, true);
      }, { signal });
    }
    moreButton.addEventListener('click', () => {
      if (currentCategory !== 'all') return;
      const firstNewCard = cards[visibleLimit];
      visibleLimit = Math.min(cards.length, visibleLimit + increment);
      apply('all');
      rememberLimit();
      if (firstNewCard) {
        firstNewCard.querySelector<HTMLHeadingElement>('h2')?.focus({ preventScroll: true });
        firstNewCard.scrollIntoView({ block: 'start', behavior: 'instant' });
      }
    }, { signal });
    window.addEventListener('popstate', restore, { signal });
    window.addEventListener('hashchange', restore, { signal });
    signal.addEventListener('abort', () => filterAnimation?.cancel(), { once: true });
    restore();
    controls.hidden = false;
  }

  document.addEventListener('astro:before-swap', () => filterAbort?.abort());
  document.addEventListener('astro:after-swap', setupPortfolio);
  document.addEventListener('astro:page-load', setupPortfolio);
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', setupPortfolio, { once: true });
  else setupPortfolio();
</script>

<style>
  [hidden] { display: none !important; }
  .portfolio-controls { display: grid; gap: 1.25rem; margin-bottom: 2rem; }
  .portfolio-filters { display: flex; flex-wrap: wrap; gap: 0.75rem; }
  .portfolio-filter[aria-pressed='true'] { background: var(--color-brand-dark); color: var(--color-brand-light); border-color: var(--color-brand-dark); }
  .portfolio-filter-check { display: inline-flex; width: 1rem; opacity: 0; }
  .portfolio-filter[aria-pressed='true'] .portfolio-filter-check { opacity: 1; }
  .portfolio-grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: 3rem; min-height: 20rem; align-items: stretch; }
  .portfolio-card { display: flex; flex-direction: column; min-width: 0; scroll-margin-top: calc(var(--site-header-height, 5.75rem) + 1rem); }
  .portfolio-card-image { position: relative; margin: 0; display: grid; aspect-ratio: 4 / 3; overflow: hidden; place-items: center; border-radius: var(--ui-radius-lg); background: var(--color-surface-container-low); }
  .portfolio-card-image :global(picture), .portfolio-card-image :global(img) { display: block; width: 100%; height: 100%; }
  .portfolio-card-image :global(picture) { position: absolute; inset: 0; }
  .portfolio-card-image :global(img) { object-fit: cover; object-position: var(--portfolio-image-position, center); }
  .portfolio-card-image[data-image-fit='contain'] :global(img) { object-fit: contain; }
  .portfolio-card-image[data-media-aspect='16:9'] { aspect-ratio: 16 / 9; }
  .portfolio-card-image[data-identity-board] { background: var(--color-brand-cream); }
  .portfolio-card-image[data-identity-board] :global(picture) { inset: 3%; width: 94%; height: 94%; }
  .portfolio-card-content { display: flex; flex: 1; flex-direction: column; min-width: 0; gap: 1rem; padding-top: 1.5rem; }
  .portfolio-tags { margin: 0; padding: 0; list-style: none; display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .portfolio-tags li { padding: 0.35rem 0.75rem; border: 1px solid var(--color-outline-variant); border-radius: var(--ui-radius-sm); }
  .portfolio-card-action { margin-top: auto; padding-top: 0.25rem; }
  .portfolio-more { display: flex; justify-content: center; margin-top: 3rem; }
  @media (min-width: 48rem) { .portfolio-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 3.5rem 2rem; } }
</style>
